{
  "name": "@ancircle-dsh-plugins/dsh-archive-ext",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness extension: open a session's workspace folder in File Explorer from the session menu, and manage archived sessions in a dedicated page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "PLAN.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js && node --check lib/core.js && node --check lib/service.js",
    "test": "node test/core.test.mjs",
    "verify": "node verify-typert-manifest.mjs && node verify-client-apply.mjs"
  }
}
