{
  "name": "@ancircle0/dsh-archive-ext",
  "version": "0.1.7",
  "description": "DeepSeek Harness extension: open a session's workspace folder or session log folder in File Explorer, and manage archived sessions in a settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "PLAN.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ancircle0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancircle0/dsh-archive-ext.git"
  },
  "homepage": "https://github.com/ancircle0/dsh-archive-ext#readme",
  "bugs": {
    "url": "https://github.com/ancircle0/dsh-archive-ext/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "archive"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-storage-domain": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/core.js && node --check lib/service.js",
    "test": "node test/core.test.mjs && node test/nav-icon.test.mjs",
    "verify": "node test/verify-client-apply.mjs"
  }
}
